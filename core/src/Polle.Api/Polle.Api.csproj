<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Polle.Infrastructure\Polle.Infrastructure.csproj" />
    <ProjectReference Include="..\Polle.Domain\Polle.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polle.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Climate trend model from pipelines/drought (cli.py trend); the API reads it next to the published app. -->
    <Content Update="ClimateTrend\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ClimateTrend\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Natural Earth 1:50m land polygons (public domain) that tell fields on land from fields drawn in the sea. -->
    <Content Remove="Features\Fields\Data\**" />
    <EmbeddedResource Include="Features\Fields\Data\land-50m.json" LogicalName="Polle.Api.land-50m.json" />
  </ItemGroup>

</Project>
